<policies>
  <inbound>
    <cors>
      <allowed-origins>
        <origin>${frontendUrl}</origin>
        <origin>${localUrl}</origin>
      </allowed-origins>
      <allowed-methods>
        <method>*</method>
      </allowed-methods>
      <allowed-headers>
        <header>*</header>
      </allowed-headers>
    </cors>

    <base />
    <set-backend-service base-url="https://${hostname}/pagopa-nodo-technical-support-service" />
  </inbound>
  <outbound>
    <base />
  </outbound>
  <backend>
    <base />
  </backend>
  <on-error>
    <base />
  </on-error>
</policies>
