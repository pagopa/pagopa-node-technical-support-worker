  "info": {
    "title": "Node technical support - API (local) ${service}",
    "version": "1.3.2-9-nodo-observability",
    "termsOfService": "https://www.pagopa.gov.it/"
  },
  "servers": [
    {
      "url": "${host}/technical-support/nodo/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "AttemptInfoDto": {
        "required": [
          "attemptId",
          "serviceIdentifier",
          "psp",
          "stazione",
          "canale",
          "attemptStartedAt",
          "startTimestampBasis",
          "timelineIncomplete",
          "timeline",
          "paFiscalCode",
          "noticeNumber",
          "state",
          "warning",
          "hasAnomaly",
          "tokenDisplay",
          "paymentToken",
          "projectionRevision"
        ],
        "type": "object",
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "serviceIdentifier": {
            "type": "string",
            "nullable": true
          },
          "psp": {
            "type": "string",
            "nullable": true
          },
          "stazione": {
            "type": "string",
            "nullable": true
          },
          "canale": {
            "type": "string",
            "nullable": true
          },
          "attemptStartedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "startTimestampBasis": {
            "$ref": "#/components/schemas/TimestampBasis"
          },
          "timelineIncomplete": {
            "type": "boolean"
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimelineItemDto"
            }
          },
          "paFiscalCode": {
            "type": "string"
          },
          "noticeNumber": {
            "type": "string"
          },
          "state": {
            "enum": [
              "PAYING",
              "PAYING_RPT",
              "PAID_NORPT",
              "PAID",
              "FAILED_NORPT",
              "FAILED",
              "CANCELLED",
              "CANCELLED_NORPT",
              "NOTICE_GENERATED",
              "NOTICE_STORED",
              "NOTICE_SENT",
              "NOTIFIED",
              "PAYMENT_RESERVED",
              "PAYMENT_SENT",
              "PAYMENT_ACCEPTED",
              "PAYMENT_REFUSED",
              "PAYMENT_UNKNOWN",
              "PAYMENT_SEND_ERROR"
            ],
            "type": "string"
          },
          "warning": {
            "type": "boolean"
          },
          "hasAnomaly": {
            "type": "boolean"
          },
          "tokenDisplay": {
            "type": "string"
          },
          "projectionRevision": {
            "format": "int64",
            "type": "integer"
          },
          "paymentToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "0500"
          },
          "description": {
            "type": "string",
            "example": "An unexpected error has occurred. Please contact support."
          },
          "statusCode": {
            "format": "int32",
            "type": "integer",
            "example": 500
          }
        }
      },
      "FaultBean": {
        "type": "object",
        "properties": {
          "faultCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "InfoResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "pagopa-node-tech-support"
          },
          "version": {
            "type": "string",
            "example": "1.2.3"
          },
          "environment": {
            "type": "string",
            "example": "dev"
          },
          "description": {
            "type": "string",
            "example": "Node tech support API"
          },
          "errorCodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorCode"
            }
          }
        }
      },
      "Instant": {
        "format": "date-time",
        "type": "string",
        "example": "2022-03-10T16:15:50Z"
      },
      "LocalDate": {
        "format": "date",
        "type": "string",
        "example": "2022-03-10"
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "pageSize": {
            "format": "int32",
            "type": "integer",
            "example": 25
          },
          "pageNumber": {
            "format": "int32",
            "type": "integer",
            "example": 1
          },
          "totPage": {
            "format": "int32",
            "type": "integer",
            "example": 3
          }
        }
      },
      "PaymentFullInfo": {
        "type": "object",
        "properties": {
          "businessProcess": {
            "type": "string"
          },
          "organizationFiscalCode": {
            "type": "string"
          },
          "noticeNumber": {
            "type": "string"
          },
          "iuv": {
            "type": "string"
          },
          "pspId": {
            "type": "string"
          },
          "brokerPspId": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "insertedTimestamp": {
            "type": "string"
          },
          "serviceIdentifier": {
            "type": "string"
          },
          "paymentToken": {
            "type": "string"
          },
          "ccp": {
            "type": "string"
          },
          "positiveBizEvtId": {
            "type": "string"
          },
          "verifyKoEvtId": {
            "type": "string"
          },
          "negativeBizEvtId": {
            "type": "string"
          },
          "faultBean": {
            "$ref": "#/components/schemas/FaultBean"
          },
          "brokerOrganizationId": {
            "type": "string"
          },
          "stationId": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "pmReceipt": {
            "type": "string"
          },
          "touchPoint": {
            "type": "string"
          },
          "fee": {
            "type": "number"
          },
          "feeOrganization": {
            "type": "number"
          }
        }
      },
      "PaymentInfo": {
        "type": "object",
        "properties": {
          "businessProcess": {
            "type": "string"
          },
          "organizationFiscalCode": {
            "type": "string"
          },
          "noticeNumber": {
            "type": "string"
          },
          "iuv": {
            "type": "string"
          },
          "pspId": {
            "type": "string"
          },
          "brokerPspId": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "insertedTimestamp": {
            "type": "string"
          },
          "serviceIdentifier": {
            "type": "string"
          },
          "paymentToken": {
            "type": "string"
          },
          "ccp": {
            "type": "string"
          },
          "positiveBizEvtId": {
            "type": "string"
          },
          "verifyKoEvtId": {
            "type": "string"
          },
          "negativeBizEvtId": {
            "type": "string"
          },
          "faultBean": {
            "$ref": "#/components/schemas/FaultBean"
          }
        }
      },
      "PaymentInfoDto": {
        "required": [
          "paFiscalCode",
          "noticeNumber",
          "state",
          "projectionRevision",
          "timelineIncomplete",
          "hasAnomaly",
          "warning",
          "attemptCount",
          "timeline",
          "attempts",
          "recipients"
        ],
        "type": "object",
        "properties": {
          "paFiscalCode": {
            "type": "string"
          },
          "noticeNumber": {
            "type": "string"
          },
          "state": {
            "description": "Logical position state; null while no position event or logical source snapshot has been observed. Never derived from attempts or recipients.",
            "enum": [
              "INSERTED",
              "PAYING",
              "PAID",
              "NOTICE_STORED",
              "NOTIFIED"
            ],
            "type": "string",
            "nullable": true
          },
          "projectionRevision": {
            "format": "int64",
            "type": "integer"
          },
          "timelineIncomplete": {
            "type": "boolean"
          },
          "hasAnomaly": {
            "type": "boolean"
          },
          "warning": {
            "type": "boolean"
          },
          "attemptCount": {
            "format": "int32",
            "type": "integer"
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimelineItemDto"
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttemptInfoDto"
            }
          },
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipientDto"
            }
          }
        },
        "additionalProperties": false
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "count": {
            "format": "int64",
            "type": "integer",
            "example": 100
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PositionPaymentSSInfo"
            }
          },
          "dateFrom": {
            "$ref": "#/components/schemas/LocalDate"
          },
          "dateTo": {
            "$ref": "#/components/schemas/LocalDate"
          }
        }
      },
      "PaymentStatus": {
        "enum": [
          "completed",
          "failed",
          "cancelled",
          "unknown"
        ],
        "type": "string"
      },
      "PaymentsFullResponse": {
        "type": "object",
        "properties": {
          "dateFrom": {
            "$ref": "#/components/schemas/LocalDate"
          },
          "dateTo": {
            "$ref": "#/components/schemas/LocalDate"
          },
          "count": {
            "format": "int32",
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentFullInfo"
            }
          }
        }
      },
      "PaymentsResponse": {
        "type": "object",
        "properties": {
          "dateFrom": {
            "$ref": "#/components/schemas/LocalDate"
          },
          "dateTo": {
            "$ref": "#/components/schemas/LocalDate"
          },
          "count": {
            "format": "int32",
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentInfo"
            }
          }
        }
      },
      "PositionPaymentSSInfo": {
        "type": "object",
        "properties": {
          "organizationFiscalCode": {
            "type": "string"
          },
          "noticeNumber": {
            "type": "string"
          },
          "creditorReferenceId": {
            "type": "string"
          },
          "paymentToken": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "insertedTimestamp": {
            "$ref": "#/components/schemas/Instant"
          },
          "updatedTimestamp": {
            "$ref": "#/components/schemas/Instant"
          },
          "insertedBy": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          },
          "serviceIdentifier": {
            "type": "string"
          }
        }
      },
      "ProblemJson": {
        "type": "object",
        "properties": {
          "title": {
            "description": "A short, summary of the problem type. Written in english and readable for engineers (usually not suited for non technical stakeholders and not localized); example: Service Unavailable",
            "type": "string"
          },
          "status": {
            "format": "int32",
            "description": "The HTTP status code generated by the origin server for this occurrence of the problem.",
            "maximum": 600,
            "minimum": 100,
            "type": "integer",
            "example": 200
          },
          "details": {
            "description": "A human readable explanation specific to this occurrence of the problem.",
            "type": "string",
            "example": "There was an error processing the request"
          }
        }
      },
      "RecipientDto": {
        "description": "Receipt recipient keyed by PA/NAV/stazioneRecipient. No token association or primary role.",
        "required": [
          "recipientId",
          "stazioneRecipient",
          "paFiscalCode",
          "noticeNumber",
          "state",
